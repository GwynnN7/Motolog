<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="12dp">
    <androidx.cardview.widget.CardView android:id="@+id/cv_gear_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:theme="@style/ThemeOverlay.MotoLog.CharcoalCard" app:cardBackgroundColor="@color/dark_gray" app:cardCornerRadius="20dp" app:cardElevation="2dp" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="8dp" android:baselineAligned="false">
            <com.google.android.material.imageview.ShapeableImageView android:id="@+id/gear_image" android:layout_width="120dp" android:layout_height="112dp" android:layout_marginEnd="10dp" android:importantForAccessibility="no" android:scaleType="centerCrop" app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.Image" android:layout_gravity="center_vertical" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:layout_gravity="center_vertical">
                <TextView android:id="@+id/tw_gear_manufacturer" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceLabelMedium" android:textColor="@color/less_dark_white" />
                <TextView android:id="@+id/tw_gear_model" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceTitleLarge" android:layout_marginTop="4dp" />
                <TextView android:id="@+id/tw_gear_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodySmall" android:layout_marginTop="8dp" />
                <TextView android:id="@+id/tw_gear_price" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="#7DD9C6" android:layout_marginTop="4dp" />
            </LinearLayout>
            <ImageButton android:id="@+id/edit_profile" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_edit" app:tint="@color/white" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/gear_edit" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>
