<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingHorizontal="16dp">
<LinearLayout android:id="@+id/emptyState" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" android:gravity="center">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ride_empty_title" android:textAppearance="?attr/textAppearanceTitleLarge" android:gravity="center" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ride_empty_body" android:textAppearance="?attr/textAppearanceBodyLarge" android:gravity="center" android:layout_marginTop="12dp" />
<com.google.android.material.button.MaterialButton android:id="@+id/startRide" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="20dp" android:text="@string/ride_start" />
</LinearLayout>
<androidx.recyclerview.widget.RecyclerView android:id="@+id/rides" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingBottom="16dp" />
</LinearLayout>
