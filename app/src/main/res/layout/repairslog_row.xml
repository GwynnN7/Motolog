<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="12dp" android:paddingTop="12dp">
<androidx.cardview.widget.CardView android:id="@+id/cv_repairs_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:theme="@style/ThemeOverlay.MotoLog.CharcoalCard" app:cardBackgroundColor="@color/dark_gray" app:cardCornerRadius="20dp" app:cardElevation="2dp" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:orientation="horizontal">
<ImageView android:id="@+id/repair_image" android:layout_width="44dp" android:layout_height="44dp" android:padding="8dp" android:importantForAccessibility="no" android:src="@drawable/ic_repair" app:tint="#7DD9C6" />
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingHorizontal="8dp" android:paddingVertical="4dp">
<TextView android:id="@+id/repair_category" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceLabelMedium" android:textColor="#7DD9C6" android:layout_marginBottom="4dp" />
<TextView android:id="@+id/tw_repair_type" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceTitleMedium" android:maxLines="2" android:ellipsize="end" />
<TextView android:id="@+id/tw_repair_notes" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="@color/less_dark_white" android:maxLines="3" android:ellipsize="end" android:layout_marginTop="6dp" />
<TextView android:id="@+id/tw_repair_distance" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodySmall" android:layout_marginTop="8dp" />
<TextView android:id="@+id/tw_repair_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="@color/less_dark_white" android:layout_marginTop="8dp" />
<TextView android:id="@+id/tw_repair_price" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceTitleSmall" android:layout_marginTop="4dp" />
</LinearLayout>
<ImageButton android:id="@+id/edit_log" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_edit" app:tint="@color/white" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/edit_log" />
</LinearLayout></androidx.cardview.widget.CardView></FrameLayout>
