<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Avoid consuming the 25 MB cloud quota with photos. Routes are part of motorcycles_db.
         Cache, noBackupFilesDir (drafts/restore journal), and device permission state are excluded. -->
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="sharedpref" path="locale_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="sharedpref" path="locale_prefs.xml" />
        <include domain="file" path="pictures" />
    </device-transfer>
</data-extraction-rules>
