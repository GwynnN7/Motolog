<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        android:key="language_category"
        android:title="@string/language"
        app:iconSpaceReserved="false">

        <ListPreference
            android:key="language"
            android:title="@string/language"
            android:entries="@array/language_entries"
            android:entryValues="@array/language_values"
            android:defaultValue="en"
            app:iconSpaceReserved="false"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="distance_category"
        android:title="@string/distance"
        app:iconSpaceReserved="false">

        <ListPreference
            android:key="distance"
            android:title="@string/distance"
            android:entries="@array/distance_entries"
            android:entryValues="@array/distance_values"
            android:defaultValue="km"
            app:iconSpaceReserved="false"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="currency_category"
        android:title="@string/currency"
        app:iconSpaceReserved="false">

        <ListPreference
            android:key="currency"
            android:title="@string/currency"
            android:entries="@array/currency_entries"
            android:entryValues="@array/currency_values"
            android:defaultValue="€"
            app:iconSpaceReserved="false"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

</PreferenceScreen>
