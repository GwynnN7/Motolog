<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        android:key="language_category"
        android:title="@string/language"
        app:iconSpaceReserved="false">

        <ListPreference
            android:key="language"
            android:title="@string/language"
            android:entries="@array/language_entries"
            android:entryValues="@array/language_values"
            android:defaultValue="en"
            app:iconSpaceReserved="false"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="distance_category"
        android:title="@string/distance"
        app:iconSpaceReserved="false">

        <ListPreference
            android:key="distance"
            android:title="@string/distance"
            android:entries="@array/distance_entries"
            android:entryValues="@array/distance_values"
            android:defaultValue="km"
            app:iconSpaceReserved="false"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="currency_category"
        android:title="@string/currency"
        app:iconSpaceReserved="false">

        <ListPreference
            android:key="currency"
            android:title="@string/currency"
            android:entries="@array/currency_entries"
            android:entryValues="@array/currency_values"
            android:defaultValue="€"
            app:iconSpaceReserved="false"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/ride_tracking_settings" app:iconSpaceReserved="false">
        <ListPreference android:key="tracking_interval_ms" android:title="@string/ride_interval"
            android:entries="@array/ride_intervals" android:entryValues="@array/ride_interval_values"
            android:defaultValue="2000" app:useSimpleSummaryProvider="true" app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat android:key="tracking_lean" android:title="@string/ride_lean_setting"
            android:summary="@string/ride_lean_setting_summary" android:defaultValue="true" app:iconSpaceReserved="false" />
    </PreferenceCategory>
</PreferenceScreen>
