<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Android 9–11: preserve databases (including SQLite sidecars), settings and language.
         Photos travel only during device transfer; the manual ZIP includes them on every version. -->
    <include domain="database" path="." />
    <include domain="file" path="datastore/settings.preferences_pb" />
    <include domain="sharedpref" path="locale_prefs.xml" />
    <include domain="file" path="pictures" requireFlags="deviceToDeviceTransfer" />
</full-backup-content>
